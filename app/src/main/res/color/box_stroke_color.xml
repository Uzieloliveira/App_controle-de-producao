<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cor quando o campo está focado -->
    <item android:state_focused="true" android:color="@color/blue_primary" />
    <!-- Cor quando o campo está habilitado (borda padrão) -->
    <item android:state_enabled="true" android:color="@color/blue_primary" />
    <!-- Cor padrão para qualquer outro estado -->
    <item android:color="@color/blue_primary" />
</selector>