<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context=".HomeActivity">

    <!-- Cabeçalho do Usuário -->
    <LinearLayout
        android:id="@+id/layoutUserHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:background="@color/color_background_header"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvUsuarioLogado"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/label_usuario_logado"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_primary" />

        <Button
            android:id="@+id/btnSairHome"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_sair"
            android:textColor="#D32F2F" />
    </LinearLayout>

    <!-- Conteúdo Central com Scroll para evitar cortes em telas menores -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutUserHeader"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <ImageView
                android:id="@+id/ivLogoWeg"
                android:layout_width="300dp"
                android:layout_height="140dp"
                android:layout_marginBottom="24dp"
                android:contentDescription="Logo WEG"
                android:scaleType="fitCenter"
                android:src="@drawable/weg_logo" />

            <TextView
                android:id="@+id/tvTituloHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:text="@string/title_home"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/blue_primary" />

            <Button
                android:id="@+id/btnAbrirCadastro"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/blue_primary"
                android:text="@string/btn_novo_cadastro"
                android:textSize="16sp"
                android:textAllCaps="true" />

            <Button
                android:id="@+id/btnInformarPecas"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="@color/blue_primary"
                android:text="Informar Peças Restantes"
                android:textSize="16sp"
                android:textAllCaps="true" />

            <Button
                android:id="@+id/btnListarCadastrados"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:backgroundTint="@color/blue_primary"
                android:text="@string/btn_listar_cadastrados"
                android:textSize="16sp"
                android:textAllCaps="true" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>